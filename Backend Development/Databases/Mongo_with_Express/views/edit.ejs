<%- include('includes/head.ejs', {title: "Edit"}) %>
<body>
    <form method="POST" action="/chats/<%=chat._id%>?_method=PUT">
        <h1>Update Message</h1>
        <p><b><%=chat.from%></b> is talking to <b><%=chat.to%></b></p>
        <label for="message">Massage:</label>
        <input type="text" name="message" id="message" required size="45" value="<%=chat.message%>">
        <button type="submit" class="btn">Update</button>
    </form>
</body>
