<%- include('includes/head.ejs', {title: "Show Chats"}) %>
<body>
    <h1 class="chat-head">Whatsapps: Users Chat</h1>
    <a href="/chats/new" class="btn">Create chat</a>
    <hr>
    <section class="chat-cards">
    <%for(let chat of chats){%>
        <div class="chat-card">
            <h3>From: <i><%=chat.from%></i></h3>
            <p><b>Message:</b> <%=chat.message%></p>
            <h3>To: <i><%=chat.to%></i></h3>
            <p>Created_At:
                <span><i><%= chat.created_at.toLocaleDateString("en-IN") %></i> </span>
                &nbsp;&nbsp;
                <span>
                    <i><%= chat.created_at.toLocaleTimeString("en-IN") %></i>
                </span>
            </p>
            <%if(chat.updated_at !== undefined){%>
                <p>Updated_At:
                <span><i><%= chat.updated_at.toLocaleDateString("en-IN") %></i> </span>
                &nbsp;&nbsp;
                <span>
                    <i><%= chat.updated_at.toLocaleTimeString("en-IN") %></i>
                </span>
            </p>
            <%}%>
            <div class="a-div">
                <a href="chats/<%=chat._id%>/edit" class="btn">Edit</a>
                <form method="POST" action="chats/<%=chat._id%>?_method=DELETE">
                    <button type="submit" class="btn">Delete</button>
                </form>
        </div>
        </div>
    <%}%>
    </section>
</body>
