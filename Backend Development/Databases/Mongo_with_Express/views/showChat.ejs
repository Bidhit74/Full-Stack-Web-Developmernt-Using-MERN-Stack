<%- include('includes/head.ejs', {title: "Show Chats"}) %>
<body>
    <h1 class="chat-head">Whatsapps: Users Chat</h1>
    <a href="/chats/new" class="btn">Create chat</a>
    <hr>
    <section class="chat-cards">
    <%for(let chat of chats){%>
        <div class="chat-card">
            <h3>From: <i><%=chat.from%></i></h3>
            <p>Message: <%=chat.message%></p>
            <h3>To: <i><%=chat.to%></i></h3>
            <p>
                <span>Date: <i><%= chat.created_at.toLocaleDateString("en-IN") %></i> </span>
                &nbsp;&nbsp;
                <span>
                    Time: <i><%= chat.created_at.toLocaleTimeString("en-IN") %></i>
                </span>
            </p>
        </div>
    <%}%>
    </section>
</body>
