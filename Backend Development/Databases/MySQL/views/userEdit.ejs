<%- include("includes/head.ejs", {title: "Edit"})%>
<body>
    <form method="post" action="/users/<%=user.id%>?_method=PATCH">
        <label for="user_name">Username: </label>
        <input type="text" id="user_name" name="username" value="<%=user.username%>" size="46">
        <br>
        <br>
        <label for="user_email">Email: </label>
        <input type="email" id="user_email" name="email" value=<%=user.email%> size="50">
        <br>
        <br>
        <label for="user_pass">Password: </label>
        <input type="password" id="user_pass" name="password" placeholder="Enter your password" required size="47">
        <br>
        <br>
        <button type="submit">Edit</button>
    </form>
</body>
