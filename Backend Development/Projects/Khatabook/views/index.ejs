<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khatabook</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <%- include('./partials/navbar') %>

        <!-- All Hisab kitab -->
        <div class="w-full max-w-md sm:max-w-lg mx-auto py-3 px-3">
            <h1 class="text-black text-lg sm:text-xl font-bold mb-5 text-center">All Hisaab Kitaab</h1>
            <% filesName.forEach(function(fileName) { %>
                <div class="flex items-center bg-blue-500 text-white rounded-xl mb-4 px-4 py-3 shadow-md">
                    <span class="flex-1 text-base sm:text-lg font-medium">
                        <%= fileName %>
                    </span>
                    <button class="rounded-full cursor-pointer p-2 hover:bg-blue-600 transition" title="View">
                        <!-- Arrow Icon -->
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                    <button class="rounded-full cursor-pointer p-2 hover:bg-blue-600 transition mx-2" title="Edit">
                        <!-- Edit Icon -->
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15.232 5.232a3 3 0 114.242 4.242L7 22H3v-4L15.232 5.232z" />
                        </svg>
                    </button>
                    <button class="rounded-full cursor-pointer p-2 hover:bg-red-200 transition text-red-500"
                        title="Delete" onclick="return confirm('Are you sure you want to delete this transaction?')">
                        <%= %>
                            <!-- Delete Icon -->
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12" />
                            </svg>
                    </button>
                </div>
                <% }) %>
        </div>
</body>

</html>