<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Insta Username</title>
  </head>
  <style>
    img{
      height: 250px;
      width: 400px;
    }
  </style>
  <body>
    <h1>This account username: <%= data.name %></h1>
    <h3>
      Followers: <%= data.followers%> &nbsp; &nbsp; &nbsp; &nbsp; Following: <%=
      data.following%>
    </h3>
    <h2>All Your Post</h2>
    <div>
      <%for(let post of data.posts){%>
        <img src="<%= post.image %>" alt="some_img">
        <h3>Likes:<%= post.likes%> &nbsp; &nbsp; &nbsp; &nbsp; Comments:<%= post.comments%> </h3>
      <%}%>
    </div>
  </body>
</html>
