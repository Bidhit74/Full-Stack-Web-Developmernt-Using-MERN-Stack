<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Roll Dice</title>
  </head>
  <body>
    <h1>Dice gave No. : <%= rollD %></h1>
    <!-- Using flow control / conditionals & loops tag in ejs : <% %> -->
    <% if(rollD == 6){ %>
        <h1>Roll Dice Again!!!</h1>
    <% } %>
  </body>
</html>
