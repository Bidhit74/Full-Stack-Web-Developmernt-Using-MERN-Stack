<%- include("include/head.ejs", {title: "All Posts"})%>
  <body>
    <h1>Quara Posts</h1>
    <%for(let post of posts){%>
    <div class="post_div">
        <h3 class="user">Username: <%= post.username%></h3>
        <ul>
            <li class="content">Content: <%= post.content%></li>
            <li class="description">Description: <%= post.description%></li>
        </ul>
    </div>
    <%}%>

  </body>
</html>
