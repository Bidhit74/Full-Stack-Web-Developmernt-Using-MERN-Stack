<%- include("../includes/head.ejs", {title: "Listings"})%>
<body>
    <h1>Add New Listing</h1>
    <hr>
    <form method="POST" action="/listing">
        <label for="title">Title: </label>
        <input type="text" id="title" name="listing[title]" required><br><br>
        <label for="description">Description: </label>
        <input type="text" id="description" name="listing[description]" required><br><br>
        <label for="imageUrl">ImageUrl: </label>
        <input type="text" id="imageUrl" name="listing[imageUrl]"><br><br>
        <label for="price">Price: </label>
        <input type="number" id="price" name="listing[price]" required><br><br>
        <label for="location">Location: </label>
        <input type="text" id="location" name="listing[location]" required><br><br>
        <label for="country">Country: </label>
        <input type="text" id="country" name="listing[country]" required><br><br>
        <button type="submit">Add</button>
    </form>
</body>
