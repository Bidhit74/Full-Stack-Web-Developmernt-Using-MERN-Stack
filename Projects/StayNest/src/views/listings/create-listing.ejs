<% layout("layouts/head") %> <% title = "Create Listing | StayNest" %>

<div class="min-h-screen bg-slate-50 py-10">
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<!-- Back to Listings -->
		<a
			href="/listings"
			class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-blue-600 transition hover:text-blue-700"
		>
			← Back to Listings
		</a>

		<!-- Create Listing Card -->
		<div class="overflow-hidden rounded-2xl bg-white shadow-lg">
			<!-- Header -->
			<div class="border-b border-slate-200 px-6 py-6 sm:px-8">
				<h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">
					Add New Listing
				</h1>

				<p class="mt-2 text-sm text-slate-500">
					Share your property with StayNest guests.
				</p>
			</div>

			<!-- Form -->
			<form
				method="POST"
				action="/listings"
				class="space-y-6 px-6 py-6 sm:px-8"
			>
				<!-- Title -->
				<div>
					<label
						for="title"
						class="mb-2 block text-sm font-semibold text-slate-700"
					>
						Title
					</label>

					<input
						type="text"
						id="title"
						name="listing[title]"
						placeholder="e.g. Beautiful Beach House"
						required
						class="w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 user-invalid:border-red-500 user-valid:border-green-500"
					/>
				</div>

				<!-- Description -->
				<div>
					<label
						for="description"
						class="mb-2 block text-sm font-semibold text-slate-700"
					>
						Description
					</label>

					<textarea
						id="description"
						name="listing[description]"
						rows="5"
						placeholder="Describe your property, amenities and what makes it special..."
						required
						class="w-full resize-y rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 user-invalid:border-red-500 user-valid:border-green-500"
					></textarea>
				</div>

				<!-- Image URL -->
				<div>
					<label
						for="imageUrl"
						class="mb-2 block text-sm font-semibold text-slate-700"
					>
						Image URL
					</label>

					<input
						type="url"
						id="imageUrl"
						name="listing[imageUrl]"
						placeholder="https://example.com/image.jpg"
						class="w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
					/>

					<p class="mt-2 text-xs text-slate-500">
						Add a URL for your property image.
					</p>
				</div>

				<!-- Price -->
				<div>
					<label
						for="price"
						class="mb-2 block text-sm font-semibold text-slate-700"
					>
						Price per night
					</label>

					<div class="relative">
						<span
							class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"
						>
							₹
						</span>

						<input
							type="number"
							id="price"
							name="listing[price]"
							min="0"
							placeholder="2500"
							required
							class="w-full rounded-lg border border-slate-300 py-3 pl-9 pr-4 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 user-invalid:border-red-500 user-valid:border-green-500"
						/>
					</div>
				</div>

				<!-- Location & Country -->
				<div class="grid gap-6 sm:grid-cols-2">
					<!-- Location -->
					<div>
						<label
							for="location"
							class="mb-2 block text-sm font-semibold text-slate-700"
						>
							Location
						</label>

						<input
							type="text"
							id="location"
							name="listing[location]"
							placeholder="e.g. Patna"
							required
							class="w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 user-invalid:border-red-500 user-valid:border-green-500"
						/>
					</div>

					<!-- Country -->
					<div>
						<label
							for="country"
							class="mb-2 block text-sm font-semibold text-slate-700"
						>
							Country
						</label>

						<input
							type="text"
							id="country"
							name="listing[country]"
							placeholder="e.g. India"
							required
							class="w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 user-invalid:border-red-500 user-valid:border-green-500"
						/>
					</div>
				</div>

				<!-- Buttons -->
				<div
					class="flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end"
				>
					<!-- Cancel -->
					<a
						href="/listings"
						class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-6 py-3 font-semibold text-slate-700 transition hover:bg-slate-50"
					>
						Cancel
					</a>

					<!-- Submit -->
					<button
						type="submit"
						class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 cursor-pointer focus:ring-blue-500 focus:ring-offset-2"
					>
						Add Listing
					</button>
				</div>
			</form>
		</div>
	</div>
</div>
