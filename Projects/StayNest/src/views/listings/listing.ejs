<%- include("../includes/head.ejs", {title: "Listings"})%>
<body>
    <h1>All Listing Data </h1>
    <hr>
    <a href="listings/new">New Listing</a>
    <hr>
    <ul>
        <% for(let listing of listings){%>
            <li>
                <a href="/listings/<%=listing._id%>">
                    <%=listing.title%>
                </a>
            </li>
        <%}%>
    </ul>
</body>
