<% layout("layouts/head") %> <% title = "Listing | StayNest" %>

<div class="min-h-screen bg-slate-50 py-8">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <!-- Back Link -->
        <a
            href="/listings"
            class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-blue-700"
        >
            ← Back to Listings
        </a>
        <h3 class="mx-auto max-w-5xl text-blue-500 px-2 sm:px-6 lg:px-8">Owned by <%= owner.username %></h3>
        <!-- Main Card -->
        <div class="overflow-hidden rounded-2xl bg-white shadow-lg">
            <!-- Listing Image -->
            <div class="aspect-video w-full overflow-hidden bg-slate-200">
                <img
                    src="<%= listing.imageUrl %>"
                    alt="<%= listing.title %>"
                    class="h-full w-full object-cover transition duration-300 hover:scale-102"
                />
            </div>
            <!-- Reviews Page -->
            <% if (reviews.length > 0) { %>
            <div class="mt-4 ml-5 flex items-center gap-3 border-b border-slate-200 pb-4">
                    <h3 class="text-xl font-bold text-slate-900">
                        Reviews
                        <span class="ml-1 text-sm font-medium text-slate-500">
                        (<%= reviews.length %>) </span>
                    </h3>

                <div class="flex items-center gap-1 rounded-full bg-orange-50 px-3 py-1">
                    <span class="text-orange-500">★</span>

                    <span class="font-semibold text-slate-800">
                        <% let rating = 0; %>

                        <% for (let review of reviews) { %>
                            <% rating += review.rating; %>
                        <% } %>

                        <%= (rating / reviews.length).toFixed(1) %>
                    </span>
                </div>
            </div>
            <% } %>
        </div>
            <!-- Listing Content -->
            <div class="p-6 sm:p-8">
                <div class="mb-6">
                    <!-- Title -->
                    <h1
                        class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl"
                    >
                        <%= listing.title %>
                    </h1>

                    <!-- Location -->
                    <p class="mt-2 flex items-center gap-2 text-slate-500">
                        📍 <%= listing.location %>, <%= listing.country %>
                    </p>
                </div>
                <!-- Description -->
                <div class="border-t border-slate-200 py-6">
                    <h2 class="mb-2 text-lg font-semibold text-slate-900">
                        About this place
                    </h2>

                    <p class="leading-7 text-slate-600">
                        <%= listing.description %>
                    </p>
                </div>

                <!-- Price -->
                <div class="border-t border-slate-200 py-6">
                    <p class="text-sm font-medium text-slate-500">
                        Price per night
                    </p>

                    <p class="mt-1 text-3xl font-bold text-slate-900">
                        ₹<%= listing.price.toLocaleString('en-IN') %>
                        <span class="text-base font-normal text-slate-500">
                            / night
                        </span>
                    </p>
                </div>

                <!-- Location & Country -->
                <div
                    class="grid gap-4 border-t border-slate-200 py-6 sm:grid-cols-2"
                >
                    <div class="rounded-xl bg-slate-50 p-4">
                        <p class="text-sm text-slate-500">Location</p>
                        <p class="mt-1 font-semibold text-slate-900">
                            <%= listing.location %>
                        </p>
                    </div>

                    <div class="rounded-xl bg-slate-50 p-4">
                        <p class="text-sm text-slate-500">Country</p>
                        <p class="mt-1 font-semibold text-slate-900">
                            <%= listing.country %>
                        </p>
                    </div>
                </div>

                <!-- Actions -->
                <% if(isLoggedIn){ %>
                <div
                    class="flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row"
                >
                <% if(isLoggedIn && owner._id.equals(currentUser._id)){ %>
                    <!-- Edit Button -->
                    <a
                        href="/listings/<%= listing._id %>/edit"
                        class="inline-flex flex-1 items-center justify-center rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white transition hover:bg-blue-700"
                    >
                        Edit Listing
                    </a>

                    <!-- Delete Button -->

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>?_method=DELETE"
                        class="flex-1"
                        >
                            <button
                            type="submit"
                            class="w-full rounded-lg border border-red-200 bg-red-50 px-5 py-3 font-semibold text-red-600 cursor-pointer transition hover:bg-red-100"
                            >
                            Delete Listing
                            </button>
                    </form>
                    <%}%>
                    <!-- Review Button -->
                    <a
                        href="/listings/<%= listing._id %>/reviews"
                        class="inline-flex flex-1 items-center justify-center rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white transition hover:bg-blue-700"
                    >
                        Add Review
                    </a>
                </div>
                <%}%>
                <!-- All Reviews -->
                <div class="mt-10 border-t border-slate-200 pt-8">
                    <h2 class="mb-6 text-3xl font-bold text-slate-900"> All Reviews </h2>
                    <% if (reviews.length === 0) { %>
                        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center">
                            <p class="text-slate-500"> No reviews yet. </p>
                        </div> <% } else { %>
                            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                                <% for (let review of reviews) { %>
                                    <div class="flex min-w-0 flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm" >
                                        <!-- Author -->
                                        <h3 class="text-lg font-semibold text-slate-900">
                                            <%= review.author.username %> </h3>
                                        <!-- Rating -->
                                        <div class="mt-1 text-sm font-semibold text-orange-500"> ★ <%= review.rating %>/5 </div>
                                        <!-- Comment -->
                                        <p class="mt-3 min-w-0 wrap-anywhere text-sm leading-6 text-slate-600"> <%= review.comment %> </p>
                                        <!-- Delete Review -->
                                        <% if ( isLoggedIn && review.author._id.equals(currentUser._id) ) { %>
                                        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-4" >
                                                <button type="submit" class="rounded-lg bg-red-500 px-3 py-1.5 text-sm font-semibold text-white transition cursor-pointer hover:bg-red-600" > Delete </button>
                                        </form> <% } %>
                                </div> <% } %>
                        </div> <% } %>
                </div>
            </div>
    </div>
</div>
