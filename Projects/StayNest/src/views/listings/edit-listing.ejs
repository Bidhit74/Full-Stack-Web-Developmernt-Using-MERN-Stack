<%- include("../includes/head.ejs", {title: "Edit Listing"})%>

<body>
    <h1>Edit Listing</h1>
    <hr>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT">
        <label for="title">Title: </label>
        <input type="text" id="title" name="listing[title]" value="<%=listing.title%>" required><br><br>
        <label for="description">Description: </label>
        <input type="text" id="description" name="listing[description]" required value="<%=listing.description%>"><br><br>
        <label for="imageUrl">ImageUrl: </label>
        <input type="text" id="imageUrl" name="listing[imageUrl]" value="<%=listing.imageUrl%>" ><br><br>
        <label for="price">Price: </label>
        <input type="number" id="price" name="listing[price]"  value="<%=listing.price%>" required><br><br>
        <label for="location">Location: </label>
        <input type="text" id="location" name="listing[location]" value="<%=listing.location%>"  required><br><br>
        <label for="country">Country: </label>
        <input type="text" id="country" name="listing[country]"  value="<%=listing.country%>" required><br><br>
        <button type="submit">Update</button>
    </form>
</body>

