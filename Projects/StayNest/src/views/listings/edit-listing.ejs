<% layout("layouts/head") %> <% title = "Edit Listing | StayNest" %>

<div class="min-h-screen bg-slate-50 py-10">
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<!-- Back to Listing -->
		<a
			href="/listings/<%= listing._id %>"
			class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-blue-600 transition hover:text-blue-700"
		>
			← Back to Listing
		</a>

		<!-- Edit Card -->
		<div class="overflow-hidden rounded-2xl bg-white shadow-lg">
			<!-- Header -->
			<div class="border-b border-slate-200 px-6 py-6 sm:px-8">
				<h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">
					Edit Listing
				</h1>

				<p class="mt-2 text-sm text-slate-500">
					Update the details of your StayNest listing.
				</p>
			</div>

			<!-- Form -->
			<form
				method="POST"
				action="/listings/<%= listing._id %>?_method=PUT"
				class="space-y-6 px-6 py-6 sm:px-8"
			>
				<!-- Title -->
				<div>
					<label
						for="title"
						class="mb-2 block text-sm font-semibold text-slate-700"
					>
						Title
					</label>

					<input
						type="text"
						id="title"
						name="listing[title]"
						value="<%= listing.title %>"
						placeholder="Enter listing title"
						required
						class="w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
					/>
				</div>

				<!-- Description -->
				<div>
					<label
						for="description"
						class="mb-2 block text-sm font-semibold text-slate-700"
					>
						Description
					</label>

					<textarea
						id="description"
						name="listing[description]"
						rows="5"
						required
						placeholder="Describe your property..."
						class="w-full resize-y rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
					>
<%= listing.description %></textarea
					>
				</div>

				<!-- Image URL -->
				<div>
					<label
						for="imageUrl"
						class="mb-2 block text-sm font-semibold text-slate-700"
					>
						Image URL
					</label>

					<input
						type="url"
						id="imageUrl"
						name="listing[imageUrl]"
						value="<%= listing.imageUrl %>"
						placeholder="https://example.com/image.jpg"
						class="w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
					/>

					<p class="mt-2 text-xs text-slate-500">
						Enter a valid URL for the listing image.
					</p>
				</div>

				<!-- Price -->
				<div>
					<label
						for="price"
						class="mb-2 block text-sm font-semibold text-slate-700"
					>
						Price per night
					</label>

					<div class="relative">
						<span
							class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-500"
						>
							₹
						</span>

						<input
							type="number"
							id="price"
							name="listing[price]"
							value="<%= listing.price %>"
							min="0"
							required
							class="w-full rounded-lg border border-slate-300 py-3 pl-9 pr-4 text-slate-900 outline-none transition focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
						/>
					</div>
				</div>

				<!-- Location & Country -->
				<div class="grid gap-6 sm:grid-cols-2">
					<!-- Location -->
					<div>
						<label
							for="location"
							class="mb-2 block text-sm font-semibold text-slate-700"
						>
							Location
						</label>

						<input
							type="text"
							id="location"
							name="listing[location]"
							value="<%= listing.location %>"
							placeholder="e.g. Patna"
							required
							class="w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
						/>
					</div>

					<!-- Country -->
					<div>
						<label
							for="country"
							class="mb-2 block text-sm font-semibold text-slate-700"
						>
							Country
						</label>

						<input
							type="text"
							id="country"
							name="listing[country]"
							value="<%= listing.country %>"
							placeholder="e.g. India"
							required
							class="w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
						/>
					</div>
				</div>

				<!-- Buttons -->
				<div
					class="flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end"
				>
					<!-- Cancel -->
					<a
						href="/listings/<%= listing._id %>"
						class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-6 py-3 font-semibold text-slate-700 transition hover:bg-slate-50"
					>
						Cancel
					</a>

					<!-- Update -->
					<button
						type="submit"
						class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 cursor-pointer focus:ring-blue-500 focus:ring-offset-2"
					>
						Update Listing
					</button>
				</div>
			</form>
		</div>
	</div>
</div>
